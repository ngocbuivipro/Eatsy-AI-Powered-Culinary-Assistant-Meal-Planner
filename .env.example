# ============================================================
#  Eatsy — Environment Variables Template
#  Copy this file to .env and fill in your actual values.
#  ⚠️  NEVER commit your real .env file to version control.
# ============================================================

# --------------------------
# Server
# --------------------------
PORT=5050

# --------------------------
# Database
# --------------------------
# MongoDB Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>
# Local MongoDB:  mongodb://localhost:27017/eatsy
MONGO_URI=your_mongodb_connection_string

# --------------------------
# Authentication
# --------------------------
# Use a long, random, hard-to-guess string (min. 32 characters recommended)
JWT_SECRET=your_super_secret_jwt_key

# --------------------------
# Google OAuth (optional — required for Google Sign-In feature)
# --------------------------
# Obtain from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_oauth_client_id

# --------------------------
# AI — Google Gemini
# --------------------------
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_google_gemini_api_key

# --------------------------
# Recipe API — Spoonacular
# --------------------------
# Obtain from: https://spoonacular.com/food-api
SPOONACULAR_API_KEY=your_spoonacular_api_key

# --------------------------
# Development Flags
# --------------------------
# Set to "true" to use local mock data instead of live API calls (dev/testing only)
USE_MOCK_DATA=false
